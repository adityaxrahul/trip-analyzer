<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel | Trip Analyzer</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />

    <!-- Chart.js for Admin Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--bg-base); overflow-x: hidden;">
    <div class="d-flex min-vh-100">
        <!-- Admin Sidebar -->
        <aside id="adminSidebar" class="admin-sidebar d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                <a class="brand-logo text-decoration-none" asp-controller="Home" asp-action="Index" asp-area="">
                    <div class="logo-icon"><i class="bi bi-compass-fill"></i></div>
                    <div class="d-flex flex-column">
                        <span class="fs-6 fw-bold" style="color: var(--text-primary);">TRIP ANALYZER</span>
                        <span class="badge fs-9 w-max" style="background: var(--accent-warning); color: #ffffff;">ADMIN PANEL</span>
                    </div>
                </a>
                <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" onclick="toggleAdminSidebar()" style="color: var(--text-primary); border-color: var(--border-default);">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <nav class="nav flex-column gap-1 flex-grow-1" style="overflow-y: auto;">
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill text-success"></i> Dashboard
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people-fill text-info"></i> Users
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Trips" ? "active" : "")" asp-area="Admin" asp-controller="Trips" asp-action="Index">
                    <i class="bi bi-clock-history text-secondary"></i> Trip Logs
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Transport" ? "active" : "")" asp-area="Admin" asp-controller="Transport" asp-action="Index">
                    <i class="bi bi-bus-front-fill text-warning"></i> Transport CRUD
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "District" ? "active" : "")" asp-area="Admin" asp-controller="District" asp-action="Index">
                    <i class="bi bi-geo-alt-fill text-success"></i> Districts CRUD
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "City" ? "active" : "")" asp-area="Admin" asp-controller="City" asp-action="Index">
                    <i class="bi bi-pin-map-fill text-info"></i> Cities CRUD
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Fare" ? "active" : "")" asp-area="Admin" asp-controller="Fare" asp-action="Index">
                    <i class="bi bi-cash-stack text-warning"></i> Fares CRUD
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Enquiries" ? "active" : "")" asp-area="Admin" asp-controller="Enquiries" asp-action="Index">
                    <i class="bi bi-envelope-paper-fill text-primary"></i> Enquiries Inbox
                </a>
                <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Chatbot" ? "active" : "")" asp-area="Admin" asp-controller="Chatbot" asp-action="Index">
                    <i class="bi bi-robot text-secondary"></i> Chatbot FAQs
                </a>
            </nav>

            <div class="pt-3 border-top px-2 mt-auto" style="border-color: var(--border-default) !important;">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary-custom btn-sm w-100 mb-2">
                    <i class="bi bi-box-arrow-up-right me-1"></i> Public Website
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-power me-1"></i> Logout
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Admin Content -->
        <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
            <!-- Header Bar -->
            <header class="navbar px-4 py-3 border-bottom d-flex justify-content-between align-items-center" style="background-color: var(--bg-card); border-color: var(--border-default) !important;">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-dark d-lg-none p-1 border-0" type="button" onclick="toggleAdminSidebar()" style="background: transparent; color: var(--text-primary);">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <h5 class="mb-0 fw-bold" style="color: var(--text-primary);">@ViewData["Title"]</h5>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge d-none d-sm-inline-block" style="background: var(--accent-success); color: #ffffff;"><i class="bi bi-shield-check me-1"></i> Authorized Admin</span>
                    <span class="small d-none d-sm-inline-block" style="color: var(--text-muted);">@User.Identity?.Name</span>
                </div>
            </header>

            <main class="p-3 p-md-4 flex-grow-1" style="min-width: 0;">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 bg-success text-white" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 bg-danger text-white" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleAdminSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            if (sidebar) {
                sidebar.classList.toggle('show-sidebar');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
