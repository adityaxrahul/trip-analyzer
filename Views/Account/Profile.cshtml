@model TripAnalyzer.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Account Profile";
}

<div class="container max-w-2xl py-5">
    <div class="glass-panel">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary">
            <div class="p-3 rounded-circle bg-primary text-white fs-3">
                <i class="bi bi-person-fill"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">@Model.FullName</h3>
                <div class="text-secondary small">Member since @Model.CreatedAt.ToString("MMM yyyy")</div>
            </div>
        </div>

        <form asp-action="Profile" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label-custom"></label>
                    <input asp-for="FullName" class="form-control form-control-custom" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label-custom"></label>
                    <input asp-for="Email" class="form-control form-control-custom" disabled />
                    <span class="text-muted fs-8">Email address cannot be changed</span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MobileNumber" class="form-label-custom"></label>
                    <input asp-for="MobileNumber" class="form-control form-control-custom" />
                    <span asp-validation-for="MobileNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label-custom">Last Active</label>
                    <input value="@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("g") : "Current Session")" class="form-control form-control-custom" disabled />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="ChangePassword" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-shield-lock me-1"></i> Change Password
                </a>
                <button type="submit" class="btn btn-primary-custom px-4">Save Changes</button>
            </div>
        </form>
    </div>
</div>
