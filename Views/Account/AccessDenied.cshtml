@{
    ViewData["Title"] = "Access Denied";
}

<div class="container max-w-md py-5 text-center">
    <div class="glass-panel py-5">
        <div class="p-3 rounded-circle bg-danger-subtle text-danger w-max mx-auto mb-3" style="width: fit-content;">
            <i class="bi bi-shield-x fs-1"></i>
        </div>
        <h2 class="fw-bold mb-2" style="color: var(--text-primary);">Access Denied</h2>
        <p class="text-secondary mb-4">
            You do not have administrative permission to access this protected route.
        </p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4">Return to Homepage</a>
    </div>
</div>
