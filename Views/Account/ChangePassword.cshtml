@model TripAnalyzer.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container max-w-md py-5">
    <div class="glass-panel">
        <h3 class="fw-bold mb-3"><i class="bi bi-shield-lock text-warning me-2"></i> Change Password</h3>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

            <div class="mb-3">
                <label asp-for="OldPassword" class="form-label-custom"></label>
                <input asp-for="OldPassword" class="form-control form-control-custom" required />
                <span asp-validation-for="OldPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label-custom"></label>
                <input asp-for="NewPassword" class="form-control form-control-custom" required />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label-custom"></label>
                <input asp-for="ConfirmNewPassword" class="form-control form-control-custom" required />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Profile" class="btn btn-secondary-custom">Cancel</a>
                <button type="submit" class="btn btn-primary-custom px-4">Update Password</button>
            </div>
        </form>
    </div>
</div>
