@model TripAnalyzer.ViewModels.EnquiryManageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Reply to Enquiry: {Model.Enquiry.Subject}";
}

@* TempData alerts *@
@if (TempData["SuccessMessage"] != null) {
    <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null) {
    <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
}

<div class="max-w-3xl mx-auto">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-sm btn-secondary-custom mb-2"><i class="bi bi-arrow-left"></i> Back to Enquiries Inbox</a>
        <h2 class="fw-bold mb-0" style="color: var(--text-primary);">Reply to Customer Enquiry</h2>
    </div>

    <!-- Original Message -->
    <div class="admin-stat-card mb-4 border border-primary-subtle">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong style="color: var(--text-primary);">From:</strong> @Model.Enquiry.Name &lt;<a href="mailto:@Model.Enquiry.Email" class="text-primary">@Model.Enquiry.Email</a>&gt;
            </div>
            <span class="text-muted small">Received @Model.Enquiry.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
        </div>
        <h5 class="fw-bold mb-2" style="color: var(--text-primary);">Subject: @Model.Enquiry.Subject</h5>
        <div class="p-3 rounded small" style="background: var(--bg-card-hover); color: var(--text-primary); border: 1px solid var(--border-default);">
            @Model.Enquiry.Message
        </div>
    </div>

    <!-- Reply Form -->
    <div class="admin-stat-card">
        <form asp-action="Reply" method="post">
            <input type="hidden" asp-for="Enquiry.Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

            <div class="mb-3">
                <label asp-for="AdminReply" class="form-label-custom"></label>
                <textarea asp-for="AdminReply" class="form-control form-control-custom" rows="6" placeholder="Type your response to send directly to the customer's email..." required></textarea>
                <span asp-validation-for="AdminReply" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label-custom"></label>
                <select asp-for="Status" class="form-select form-control-custom">
                    <option value="Pending">Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved" selected>Resolved</option>
                </select>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                <button type="submit" class="btn btn-primary-custom px-4">
                    <i class="bi bi-send-fill me-1"></i> Send Reply Email
                </button>
            </div>
        </form>
    </div>
</div>
