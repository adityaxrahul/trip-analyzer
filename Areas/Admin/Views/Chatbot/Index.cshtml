@model List<TripAnalyzer.Models.ChatbotFAQ>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chatbot Knowledge Base FAQs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0" style="color: var(--text-primary);">Chatbot FAQs (@Model.Count)</h3>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-1"></i> Add New FAQ
    </a>
</div>

<div class="admin-stat-card">
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Category</th>
                    <th>Question</th>
                    <th>Answer Snippet</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@f.DisplayOrder</td>
                        <td><span class="badge bg-secondary">@f.Category</span></td>
                        <td class="fw-bold max-w-xs" style="color: var(--text-primary);">@f.Question</td>
                        <td class="small text-truncate max-w-sm" style="color: var(--text-muted);">@f.Answer</td>
                        <td>
                            <span class="badge @(f.IsActive ? "bg-success" : "bg-danger")">
                                @(f.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-secondary-custom">Edit</a>
                                <form asp-action="ToggleActive" method="post">
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <button type="submit" class="btn btn-sm @(f.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(f.IsActive ? "Disable" : "Enable")
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this FAQ?');">
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
